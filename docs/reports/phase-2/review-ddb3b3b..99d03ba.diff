+    width = style = color = None
+    for group in groups:
+        if len(group) == 1 and isinstance(group[0], Ident):
+            keyword = group[0].value.lower()
+            if keyword in _BORDER_STYLE_KEYWORDS:
+                if style is not None:
+                    return None
+                style = Keyword(keyword)
+                continue
