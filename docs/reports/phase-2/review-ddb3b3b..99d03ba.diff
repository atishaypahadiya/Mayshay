+
+# --------------------------------------------------------------------------
+# display / font-size
+# --------------------------------------------------------------------------
+
+
+def _single_token(tokens: list[CssToken]) -> CssToken | None:
+    groups = _split_top_level(tokens)
+    if len(groups) != 1 or len(groups[0]) != 1:
+        return None
+    return groups[0][0]
