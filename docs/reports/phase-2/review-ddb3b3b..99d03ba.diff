+        return None
+    if not isinstance(group[-1], RParen):
+        return None
+    args = _split_args(group[1:-1])
+    if name == "rgba" and len(args) != 4:
+        return None
+    if name == "rgb" and len(args) not in (3, 4):
+        return None
