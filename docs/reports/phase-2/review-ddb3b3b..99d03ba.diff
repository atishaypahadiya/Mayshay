+# --------------------------------------------------------------------------
+# border
+# --------------------------------------------------------------------------
+
+
+def _parse_border(tokens: list[CssToken]) -> dict[str, object] | None:
+    """Width, style and color, in any order, at most one of each kind."""
+    groups = _split_top_level(tokens)
+    if not groups:
+        return None
