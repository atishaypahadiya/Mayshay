+# -- RuleIndex --
+
+INDEX_RULES = (
+    "#Main", "#other", ".lead", ".box", ".missing", "span", "p", "a", "b",
+    "i", "div p", "*", "[id]", ":is(.lead, span)", "p::before", "div.box",
+)
