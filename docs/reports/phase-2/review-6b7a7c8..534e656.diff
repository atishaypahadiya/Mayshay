+        # matches nothing.
+        ('<!DOCTYPE html PUBLIC "">', "no-quirks"),
+        # Case-insensitive on the identifier, not just on the keyword.
+        ('<!DOCTYPE html PUBLIC "-//w3o//dtd w3 html strict 3.0//en//">', "quirks"),
